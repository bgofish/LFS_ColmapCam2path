body.plugin-panel {
    padding: 0;
}

.panel-shell {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    padding: 16dp;
}

.panel-header {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    margin-bottom: 4dp;
}

.panel-kicker {
    color: #7fb8ff;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.8dp;
    text-transform: uppercase;
}

.panel-title {
    font-size: 18dp;
    font-weight: bold;
}

.panel-note {
    color: #a0a8b7;
}

/* --- Collapsible sections --- */

.section {
    display: block;
    border: 1dp #2a2f3a;
    border-radius: 6dp;
    background-color: #1c1f27;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 8dp;
    padding: 10dp 12dp;
    cursor: pointer;
}

.section-header:hover {
    background-color: #262b36;
}

.section-arrow {
    display: inline-block;
    color: #7fb8ff;
    font-size: 11dp;
    transition: transform 0.12s;
}

.section-arrow.open {
    transform: rotate(90deg);
}

.section-title {
    font-weight: bold;
    color: #e6e9ef;
}

.section-body {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    padding: 0 12dp 12dp 12dp;
}

.section-hint {
    color: #a0a8b7;
    font-size: 11dp;
}

/* --- Fields --- */

.field-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.field-label {
    color: #c3c8d1;
    width: 118dp;
    flex-shrink: 0;
}

.field-input {
    flex-grow: 1;
    padding: 5dp 8dp;
    background-color: #12141a;
    border: 1dp #3a3f4c;
    border-radius: 4dp;
    color: #e6e9ef;
    transition: background-color 0.12s, border 0.12s;
}

.field-input:hover {
    border: 1dp #5a6070;
    background-color: #161920;
}

.field-input:focus {
    border: 2dp #7fb8ff;
    background-color: #202b3d;
    padding: 4dp 7dp;
    color: #ffffff;
}

.field-input.wide {
    flex-grow: 1;
}

/* --- Drag sliders --- */

.slider-combo {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    flex-grow: 1;
    min-width: 0;
}

.field-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40dp;
}

.slider-text {
    width: 72dp;
    flex-grow: 0;
    flex-shrink: 0;
    text-align: right;
}

input.range {
    display: block;
    height: 16dp;
}

input.range slidertrack {
    display: block;
    width: 100%;
    height: 6dp;
    margin-top: 5dp;
    background-color: #12141a;
    border: 1dp #3a3f4c;
    border-radius: 3dp;
}

input.range slidertrack sliderprogress {
    background-color: #3a7bd5;
    border-radius: 3dp;
}

input.range sliderbar {
    width: 6dp;
    height: 6dp;
    margin-top: 0dp;
    background-color: #e6e9ef;
    border: 1dp #7fb8ff;
    border-radius: 3dp;
}

input.range sliderbar:hover {
    background-color: #ffffff;
}

.option-group {
    display: flex;
    flex-direction: row;
    gap: 16dp;
}

.option-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 7dp;
    cursor: pointer;
    color: #c3c8d1;
}

.option-item:hover .option-box {
    border: 1dp #7fb8ff;
}

.option-box {
    display: inline-block;
    width: 14dp;
    height: 14dp;
    flex-shrink: 0;
    border: 1dp #5a6070;
    background-color: #12141a;
}

.option-box.checkbox {
    border-radius: 3dp;
}

.option-box.radio {
    border-radius: 7dp;
}

.option-box.checked {
    background-color: #3a7bd5;
    border: 1dp #7fb8ff;
}

.derived-text {
    color: #7fb8ff;
    font-size: 11dp;
}

.button-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

/* --- Buttons --- */

.action-button {
    padding: 8dp 14dp;
    border-radius: 4dp;
    background-color: #3a7bd5;
    color: #ffffff;
    text-align: center;
}

.action-button:hover {
    background-color: #4a8be5;
}

.action-button.secondary {
    background-color: #3a3f4c;
}

.action-button.secondary:hover {
    background-color: #474d5c;
}

.action-button.pick {
    background-color: #002211;
    color: #00ff88;
    border: 1dp #006633;
}

.action-button.pick:hover {
    background-color: #003318;
}

.action-button.danger {
    background-color: #2a1414;
    color: #f87171;
    border: 1dp #7a2c2c;
}

.action-button.danger:hover {
    background-color: #3a1a1a;
}

.action-button.update {
    background-color: #12141a;
    color: #7fb8ff;
    border: 1dp #3a5f8f;
}

.action-button.update:hover {
    background-color: #1a2230;
}

.action-button.edit {
    background-color: #201229;
    color: #c792ea;
    border: 1dp #5b3a73;
}

.action-button.edit:hover {
    background-color: #2c1a3a;
}

/* --- Status --- */

.status-text {
    color: #4ade80;
    padding: 8dp 4dp 0 4dp;
}

.status-text.error {
    color: #f87171;
}

.warning-text {
    color: #f5a623;
    font-size: 11dp;
    padding: 0 0 4dp 0;
}
