body {
    font-family: rmlui-debugger-font, sans-serif;
    font-size: 13dp;
    color: #d0d6e8;
    background-color: transparent;
    padding: 8dp;
}

.panel-header { margin-bottom: 10dp; }
.panel-title   { font-size: 14dp; color: #7fb8ff; font-weight: bold; margin: 0; }
.panel-subtitle { font-size: 11dp; color: #6a7190; margin: 2dp 0 0 0; }

.section-header {
    margin-top: 10dp;
    margin-bottom: 4dp;
    padding: 4dp 0;
    border-bottom: 1dp #2e3450;
    color: #a0aacc;
    font-weight: bold;
    cursor: pointer;
}
.section-arrow  { margin-right: 6dp; color: #7fb8ff; }
.section-title  { }
.section-body   { padding: 4dp 0 8dp 4dp; }

.field-row {
    display: flex;
    align-items: center;
    margin-bottom: 5dp;
}
.field-label {
    width: 160dp;
    color: #a0aacc;
    flex-shrink: 0;
}
.slider {
    flex: 1;
    margin-right: 6dp;
}
.field-input {
    width: 70dp;
    background-color: #262a3d;
    color: #d0d6e8;
    border: 1dp #3c4466;
    padding: 3dp 5dp;
}
.field-input.wide {
    flex: 1;
    width: auto;
}

.button-row {
    display: flex;
    margin-top: 6dp;
    margin-bottom: 2dp;
    gap: 6dp;
}
.action-button {
    padding: 6dp 14dp;
    border: none;
    cursor: pointer;
    font-size: 12dp;
}
.action-button.primary {
    background-color: #7fb8ff;
    color: #0d1120;
    font-weight: bold;
    width: 100%;
}
.action-button.primary:hover { background-color: #a8d0ff; }
.action-button.secondary {
    background-color: #2e3450;
    color: #d0d6e8;
    flex: 1;
}
.action-button.secondary:hover { background-color: #3c4466; }

.section-hint  { font-size: 11dp; color: #6a7190; margin: 2dp 0 4dp 0; }
.derived-text  { font-size: 11dp; color: #7fb8ff; margin: 3dp 0; }

.status-ok    { color: #4ecf7e; font-size: 11dp; margin-top: 8dp; }
.status-error { color: #ff6b6b; font-size: 11dp; margin-top: 8dp; }
