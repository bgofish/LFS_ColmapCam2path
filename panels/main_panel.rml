<rml>
<head>
  <link type="text/rcss" href="main_panel.rcss"/>
</head>
<body id="body" class="plugin-panel ColmapCamPath-panel" data-model="colmap_campath">
  <div class="panel-shell">

    <div class="panel-header">
      <span class="panel-kicker">Camera Tools</span>
      <span class="panel-title">Cameras &#8594; Sequencer-KeyFrames</span>
      <span class="panel-note">Build a Sequencer path from scene cameras.</span>
    </div>

    <!-- ================= Options ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_options = !sec_options">
        <span class="section-arrow" data-class-open="sec_options">&#9656;</span>
        <span class="section-title">Options</span>
      </div>
      <div class="section-body" data-if="sec_options">

        <div class="setting-row setting-row--aligned">
          <span class="setting-row__label-col">FPS</span>
          <div class="setting-row__control-col setting-row__control-col--slider">
            <input type="range" class="setting-slider" min="0.1" max="5" step="0.1" data-value="fps"/>
          </div>
        </div>

        <div class="field-row">
          <span class="field-label">Skip disabled</span>
          <input type="checkbox" data-value="skip_disabled"/>
        </div>
        <p class="section-hint">When checked, cameras with &#8220;Disabled for Training&#8221; in the scene are excluded from the path.</p>

        <div class="field-row">
          <span class="field-label">Ease in/out</span>
          <input type="checkbox" data-value="ease_in_out"/>
        </div>
        <p class="section-hint">When checked, every keyframe in each part eases (3) except the last, which eases out (0) — instead of the default constant speed (0) throughout.</p>

        <div class="setting-row setting-row--aligned">
          <span class="setting-row__label-col">Max Keyframes</span>
          <div class="setting-row__control-col setting-row__control-col--slider">
            <input type="range" class="setting-slider" min="0" max="500" step="1" data-value="max_keyframes"/>
          </div>
        </div>
        <p class="section-hint">Splits the path into multiple files of at most this many cameras each (e.g. colmap_camera_path_Pt01.json, _Pt02.json, &#8230;). 0 = no limit, single file.</p>

      </div>
    </div>

    <!-- ================= Output ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_output = !sec_output">
        <span class="section-arrow" data-class-open="sec_output">&#9656;</span>
        <span class="section-title">Output</span>
      </div>
      <div class="section-body" data-if="sec_output">

        <div class="field-row">
          <span class="field-label">Output file (.json)</span>
          <input type="text" class="field-input wide" data-value="output_path"/>
        </div>

        <div class="button-row">
          <button id="btn-refresh" class="action-button secondary">Refresh Count</button>
        </div>
        <p class="derived-text" data-if="cam_count_text != ''">{{ cam_count_text }}</p>

        <button id="btn-build" class="action-button">Build Path &#8594; JSON</button>

      </div>
    </div>

    <!-- ================= Previous Runs ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_previous = !sec_previous">
        <span class="section-arrow" data-class-open="sec_previous">&#9656;</span>
        <span class="section-title">Previous Runs</span>
      </div>
      <div class="section-body" data-if="sec_previous">

        <button id="btn-select-last" class="action-button secondary">Select Last Build Json Files</button>

        <div class="field-row">
          <span class="field-label">Log file path</span>
          <input type="text" class="field-input wide" data-value="log_browse_path" placeholder="path to last_build_log.json"/>
        </div>
        <div class="button-row">
          <button id="btn-browse-log" class="action-button secondary">Browse&#8230;</button>
          <button id="btn-select-from-path" class="action-button secondary">Load From Log File&#8230;</button>
        </div>

      </div>
    </div>

    <!-- ================= Sequencer ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_sequencer = !sec_sequencer">
        <span class="section-arrow" data-class-open="sec_sequencer">&#9656;</span>
        <span class="section-title">Sequencer</span>
      </div>
      <div class="section-body" data-if="sec_sequencer">

        <div class="field-row" data-if="num_parts > 1">
          <span class="field-label">Part</span>
          <div class="slider-combo">
            <button id="btn-part-prev" class="action-button secondary step-button">&#9664;</button>
            <input type="text" class="field-input step-value" data-value="part_text"/>
            <button id="btn-part-next" class="action-button secondary step-button">&#9654;</button>
          </div>
        </div>
        <p class="derived-text" data-if="parts_info_text != ''">{{ parts_info_text }}</p>

        <div class="button-row">
          <button id="btn-load"   class="action-button">Load into Sequencer</button>
          <button id="btn-backup" class="action-button secondary">Backup Now</button>
        </div>
        <p class="derived-text" data-if="last_backup_text != ''">{{ last_backup_text }}</p>

      </div>
    </div>

    <!-- ================= Status ================= -->
    <p class="status-text" data-class-error="!status_ok" data-if="status != ''">{{ status }}</p>

  </div>
</body>
</rml>
