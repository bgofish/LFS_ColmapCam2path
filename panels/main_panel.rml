<rml>
<head>
  <link type="text/rcss" href="main_panel.rcss"/>
</head>
<body id="body" class="plugin-panel ColmapCamPath-panel" data-model="colmap_campath">
  <div class="panel-shell">

    <div class="panel-header">
      <span class="panel-kicker">Camera Tools</span>
      <span class="panel-title">COLMAP &#8594; LFS</span>
      <span class="panel-note">Build a Sequencer path from scene cameras using their COLMAP rotation.</span>
    </div>

    <!-- ================= Options ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_options = !sec_options">
        <span class="section-arrow" data-class-open="sec_options">&#9656;</span>
        <span class="section-title">Options</span>
      </div>
      <div class="section-body" data-if="sec_options">

        <div class="field-row">
          <span class="field-label">FPS</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="0.1" max="120" step="0.1" data-value="fps"/>
            <input type="text" class="field-input slider-text" data-value="fps_text"/>
          </div>
        </div>

        <div class="field-row">
          <span class="field-label">Skip disabled</span>
          <input type="checkbox" data-value="skip_disabled"/>
        </div>
        <p class="section-hint">When checked, cameras with &#8220;Disabled for Training&#8221; in the scene are excluded from the path.</p>

      </div>
    </div>

    <!-- ================= Output ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_output = !sec_output">
        <span class="section-arrow" data-class-open="sec_output">&#9656;</span>
        <span class="section-title">Output</span>
      </div>
      <div class="section-body" data-if="sec_output">

        <div class="field-row">
          <span class="field-label">Output file (.json)</span>
          <input type="text" class="field-input wide" data-value="output_path"/>
        </div>

        <div class="button-row">
          <button id="btn-refresh" class="action-button secondary">Refresh Count</button>
        </div>
        <p class="derived-text" data-if="cam_count_text != ''">{{ cam_count_text }}</p>

        <button id="btn-build" class="action-button">Build Path &#8594; JSON</button>

      </div>
    </div>

    <!-- ================= Sequencer ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_sequencer = !sec_sequencer">
        <span class="section-arrow" data-class-open="sec_sequencer">&#9656;</span>
        <span class="section-title">Sequencer</span>
      </div>
      <div class="section-body" data-if="sec_sequencer">

        <div class="button-row">
          <button id="btn-load"   class="action-button">Load into Sequencer</button>
          <button id="btn-backup" class="action-button secondary">Backup Now</button>
        </div>
        <p class="derived-text" data-if="last_backup_text != ''">{{ last_backup_text }}</p>

        <div class="button-row">
          <button id="btn-debug" class="action-button secondary">Debug: Log Scene Tree</button>
        </div>
        <p class="section-hint">After rotating/translating the scene, click this and check the LFS log to verify the world_transform is being read correctly.</p>

      </div>
    </div>

    <!-- ================= Status ================= -->
    <p class="status-text" data-class-error="!status_ok" data-if="status != ''">{{ status }}</p>

  </div>
</body>
</rml>
