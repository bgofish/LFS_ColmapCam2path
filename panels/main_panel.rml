<rml>
<head>
  <link type="text/rcss" href="main_panel.rcss"/>
</head>
<body id="body" class="plugin-panel ColmapCamPath-panel" data-model="colmap_campath">

  <div class="panel-header">
    <p class="panel-title">Scene Cameras → Sequencer Camera Path</p>
    <p class="panel-subtitle">Build a Sequencer path from active scene cameras.</p>
  </div>

  <!-- ── Options ─────────────────────────────────────────────────────────── -->
  <div class="section-header" data-event-click="toggle_sec_options">
    <span class="section-arrow" data-class-open="sec_options">&#9656;</span>
    <span class="section-title">Options</span>
  </div>
  <div class="section-body" data-if="sec_options">

    <div class="field-row">
      <span class="field-label">FPS</span>
      <input class="slider" type="range" data-value="fps" min="0.1" max="20" step="0.1"/>
      <input type="text" class="field-input" data-value="fps_text"/>
    </div>

    <div class="field-row">
      <span class="field-label">Skip disabled cameras</span>
      <input type="checkbox" data-value="skip_disabled"/>
    </div>
    <p class="section-hint">When checked, cameras with "Disabled for Training" in the scene are excluded from the path.</p>

  </div>

  <!-- ── Output ──────────────────────────────────────────────────────────── -->
  <div class="section-header">
    <span class="section-title">Output</span>
  </div>
  <div class="section-body">

    <div class="field-row">
      <span class="field-label">Output file (.json)</span>
      <input type="text" class="field-input wide" data-value="output_path"/>
    </div>

    <div class="button-row">
      <button id="btn-refresh" class="action-button secondary">Refresh Count</button>
    </div>
    <p class="derived-text" data-if="cam_count_text != ''">{{ cam_count_text }}</p>

    <div class="button-row">
      <button id="btn-build" class="action-button primary">Build Path → JSON</button>
    </div>

  </div>

  <!-- ── Sequencer ───────────────────────────────────────────────────────── -->
  <div class="section-header">
    <span class="section-title">Sequencer</span>
  </div>
  <div class="section-body">

    <div class="button-row">
      <button id="btn-load"   class="action-button secondary">Load into Sequencer</button>
      <button id="btn-backup" class="action-button secondary">Backup Sequencer</button>
    </div>
    <p class="derived-text" data-if="last_backup_text != ''">{{ last_backup_text }}</p>

  </div>

  <!-- ── Status bar ──────────────────────────────────────────────────────── -->
  <div data-if="status != ''">
    <p class="status-ok"   data-if="status_ok">{{ status }}</p>
    <p class="status-error" data-if="!status_ok">&#9888; {{ status }}</p>
  </div>

</body>
</rml>
